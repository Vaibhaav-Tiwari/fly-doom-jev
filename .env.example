# Jev (TypeSafe System One structured-probability API) — server-side only.
# NEVER expose to the browser. Leave JEV_API_KEY empty to run with the
# deterministic mock Jev (default).
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=30
# Decide path appended to JEV_BASE_URL. Official API: /systemone (default).
# Hosted proxy (JEV_BASE_URL=https://jevtypesafeai.com/api/v1): /decide
JEV_DECIDE_PATH=/systemone
